@model List<PlataformaCreditos.Models.SolicitudCredito>

<h2 class="mb-3">📄 Mis Solicitudes</h2>

<form method="get" class="row g-2 mb-4">

    <div class="col-md-2">
        <label>Estado</label>
        <select name="estado" class="form-control">
            <option value="">Todos</option>
            <option value="Pendiente" selected="@(Context.Request.Query["estado"]=="Pendiente")">Pendiente</option>
            <option value="Aprobado" selected="@(Context.Request.Query["estado"]=="Aprobado")">Aprobado</option>
            <option value="Rechazado" selected="@(Context.Request.Query["estado"]=="Rechazado")">Rechazado</option>
        </select>
    </div>

    <div class="col-md-2">
        <label>Min Monto</label>
        <input type="number" name="minMonto" step="0.01" class="form-control"
               value="@Context.Request.Query["minMonto"]" />
    </div>

    <div class="col-md-2">
        <label>Max Monto</label>
        <input type="number" name="maxMonto" step="0.01" class="form-control"
               value="@Context.Request.Query["maxMonto"]" />
    </div>

    <div class="col-md-2">
        <label>Fecha Inicio</label>
        <input type="date" name="fechaInicio" class="form-control"
               value="@Context.Request.Query["fechaInicio"]" />
    </div>

    <div class="col-md-2">
        <label>Fecha Fin</label>
        <input type="date" name="fechaFin" class="form-control"
               value="@Context.Request.Query["fechaFin"]" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>

</form>

<!-- 🔥 MENSAJE SIN RESULTADOS -->
@if (Model != null && !Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron resultados con los filtros aplicados.
    </div>
}

<!-- 🔥 ERRORES -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<!-- 🔥 TABLA -->
<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>S/ @item.MontoSolicitado</td>
                    <td>@item.FechaSolicitud.ToString("yyyy-MM-dd")</td>

                    <td>
                        @if (item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente)
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else if (item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado)
                        {
                            <span class="badge bg-success">Aprobado</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rechazado</span>
                        }
                    </td>

                    <td>
                        <a class="btn btn-sm btn-info"
                           asp-controller="Solicitudes"
                           asp-action="Detalle"
                           asp-route-id="@item.Id">
                            Ver
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>

</table>