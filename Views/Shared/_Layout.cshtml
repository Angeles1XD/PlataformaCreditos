@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlataformaCreditos</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

@{
    var ultima = Context.Session.GetString("UltimaSolicitud");
}

<!-- 🔹 NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
    <div class="container-fluid">

        <!-- LOGO -->
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            PlataformaCreditos
        </a>

        <!-- MENÚ -->
        <div class="collapse navbar-collapse">

            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Solicitudes" asp-action="Index">
                        Mis Solicitudes
                    </a>
                </li>

                <!-- 🔥 PANEL ANALISTA -->
                <li class="nav-item">
                    <a class="nav-link text-danger fw-bold"
                       asp-controller="Analista"
                       asp-action="Index">
                        Panel Analista
                    </a>
                </li>

            </ul>

            <!-- LOGIN -->
            <partial name="_LoginPartial" />

        </div>
    </div>
</nav>

<!-- 🔥 ÚLTIMA SOLICITUD (SESIÓN) -->
@if (ultima != null)
{
    <div class="container">
        <div class="alert alert-success text-center fw-bold">
            🔎 Última solicitud: S/ @ultima
            |
            <a class="btn btn-sm btn-outline-success ms-2"
               asp-controller="Solicitudes"
               asp-action="Index">
                Ver solicitudes
            </a>
        </div>
    </div>
}

<!-- CONTENIDO -->
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<!-- FOOTER -->
<footer class="border-top footer text-muted mt-4">
    <div class="container text-center">
        &copy; 2026 - PlataformaCreditos
    </div>
</footer>

<!-- SCRIPTS -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>